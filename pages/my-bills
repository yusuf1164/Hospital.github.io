<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Bills - DEEN Hospital</title>
    <link rel="stylesheet" href="../style.css">
</head>
<body>
    <header id="header-placeholder"></header>

    <main>
        <div class="table-container" style="max-width: 900px;">
            <div class="page-header">
                <h1>💳 My Bills</h1>
                <p>View your invoices and payment history.</p>
            </div>

            <!-- Linked Profiles Selector -->
            <div class="form-card" id="selectorCard" style="margin-bottom: 30px; display: none;">
                <div class="form-group" style="margin-bottom: 0;">
                    <label>Select Profile</label>
                    <select id="profileSelect" required>
                        <option value="">Loading profiles...</option>
                    </select>
                </div>
            </div>

            <!-- Empty State -->
            <div class="form-card" id="emptyState" style="text-align: center; display: none;">
                <h3 style="color: #1e3a8a;">No Records Linked</h3>
                <p style="margin-bottom: 20px;">You need to link a hospital ID to view bills.</p>
                <a href="link-record.html" class="btn btn-primary" style="display: inline-block; padding: 10px 20px; text-decoration: none;">🔗 Link Hospital ID</a>
            </div>

            <!-- Bills Table -->
            <div id="billsContainer" style="display: none;">
                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Service</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="billsTableBody">
                        <tr><td colspan="4" style="text-align:center; color:#888;">Loading bills...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <footer id="footer-placeholder"></footer>

    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-auth.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-firestore.js"></script>
    <script src="../script.js?v=103"></script>

    <script>
        auth.onAuthStateChanged((user) => {
            if (!user) { window.location.href = '../login.html'; return; }

            const selectorCard = document.getElementById('selectorCard');
            const profileSelect = document.getElementById('profileSelect');
            const emptyState = document.getElementById('emptyState');
            const billsContainer = document.getElementById('billsContainer');
            const tbody = document.getElementById('billsTableBody');
            let allPatientsData = [];

            // 1. Get User's Linked IDs
            db.collection('users').doc(user.uid).get().then(doc => {
                const userData = doc.data();
                const linkedIds = userData.linkedPatientIds || [];

                if (linkedIds.length === 0) {
                    emptyState.style.display = 'block';
                    return;
                }

                selectorCard.style.display = 'block';

                // 2. Fetch the details (names) for these linked IDs
                db.collection('patients').get().then(snapshot => {
                    snapshot.forEach(doc => {
                        const p = doc.data();
                        if (linkedIds.includes(p.patientId)) {
                            allPatientsData.push({ firestoreId: doc.id, ...p });
                        }
                    });

                    // Populate Dropdown
                    profileSelect.innerHTML = '<option value="">Select a profile...</option>';
                    allPatientsData.forEach(p => {
                        profileSelect.innerHTML += `<option value="${p.firestoreId}">${p.firstName} ${p.lastName} (ID: ${p.patientId})</option>`;
                    });

                    // Auto-select if only 1 profile
                    if (allPatientsData.length === 1) {
                        profileSelect.selectedIndex = 1;
                        loadBills(allPatientsData[0].firestoreId);
                    }
                });
            });

            // 3. Handle Dropdown Change
            profileSelect.addEventListener('change', (e) => {
                const firestoreId = e.target.value;
                if (firestoreId) {
                    loadBills(firestoreId);
                } else {
                    billsContainer.style.display = 'none';
                }
            });

            // 4. Load Bills Function
            function loadBills(firestorePatientId) {
                billsContainer.style.display = 'block';
                tbody.innerHTML = `<tr><td colspan="4" style="text-align:center; color:#888;">Loading bills...</td></tr>`;

                db.collection('bills').where('patientId', '==', firestorePatientId).get().then(snapshot => {
                    if (snapshot.empty) {
                        tbody.innerHTML = `<tr><td colspan="4" style="text-align:center; color:#888;">No bills found for this profile.</td></tr>`;
                        return;
                    }

                    let bills = [];
                    snapshot.forEach(doc => bills.push(doc.data()));

                    // Sort by date manually
                    bills.sort((a, b) => {
                        const timeA = a.createdAt ? a.createdAt.toMillis() : 0;
                        const timeB = b.createdAt ? b.createdAt.toMillis() : 0;
                        return timeB - timeA;
                    });

                    tbody.innerHTML = '';
                    let totalPending = 0;

                    bills.forEach(d => {
                        const date = d.createdAt ? d.createdAt.toDate().toLocaleDateString() : 'N/A';
                        const badge = d.status === 'Paid' ? '<span class="status-badge status-complete">Paid</span>' : '<span class="status-badge status-pending">Pending</span>';
                        if (d.status !== 'Paid') totalPending += Number(d.amount);

                        tbody.innerHTML += `
                            <tr>
                                <td>${date}</td>
                                <td>${d.service}</td>
                                <td>₦${Number(d.amount).toLocaleString()}</td>
                                <td>${badge}</td>
                            </tr>
                        `;
                    });

                    // Add total pending summary at the bottom
                    if (totalPending > 0) {
                        tbody.innerHTML += `
                            <tr style="background-color: #fef3c7;">
                                <td colspan="2" style="text-align:right; font-weight:bold; color:#92400e;">Total Outstanding:</td>
                                <td style="font-weight:bold; color:#92400e;">₦${totalPending.toLocaleString()}</td>
                                <td></td>
                            </tr>
                        `;
                    }
                });
            }
        });
    </script>
</body>
</html>
